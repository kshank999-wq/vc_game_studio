diff --git a/apps/web/src/lib/__tests__/checkout-kind.test.ts b/apps/web/src/lib/__tests__/checkout-kind.test.ts
new file mode 100644
index 0000000..a59b2ad
--- /dev/null
+++ b/apps/web/src/lib/__tests__/checkout-kind.test.ts
@@ -0,0 +1,20 @@
+import { describe, expect, it } from 'vitest';
+import { checkoutKind } from '../checkout-kind';
+
+/** The webhook fulfils a desktop licence only for VC Writer's own desktop checkouts. */
+describe('checkout kind', () => {
+  it("is a desktop purchase for VC Writer's own checkouts, stamped or not", () => {
+    expect(checkoutKind({ metadata: { platform: 'windows', supabase_user_id: 'u1', plan: 'monthly' } })).toBe('desktop');
+    expect(checkoutKind({ metadata: { product: 'vc-writer', platform: 'macos' } })).toBe('desktop');
+    expect(checkoutKind({ metadata: null })).toBe('desktop');
+    expect(checkoutKind({})).toBe('desktop');
+  });
+
+  it("leaves another VC product's checkout to that product", () => {
+    expect(checkoutKind({ metadata: { product: 'vc-game-studio', supabase_user_id: 'u1', plan: 'studio' } })).toBe('other-product');
+  });
+
+  it('is no desktop purchase for a Writers Room seat checkout', () => {
+    expect(checkoutKind({ metadata: { room_id: 'r1' } })).toBe('room');
+  });
+});
diff --git a/apps/web/src/lib/checkout-kind.ts b/apps/web/src/lib/checkout-kind.ts
new file mode 100644
index 0000000..5d92421
--- /dev/null
+++ b/apps/web/src/lib/checkout-kind.ts
@@ -0,0 +1,22 @@
+/**
+ * What a completed checkout is for, read from the metadata it was stamped
+ * with, so the webhook fulfils only VC Writer's own desktop purchases.
+ *
+ * Every product of VC Software sells through the one Stripe account, and
+ * Stripe sends every product's events to every product's webhook. A checkout
+ * stamped with another product (`metadata.product`, e.g. 'vc-game-studio')
+ * is that product's to fulfil, and a Writers Room seat checkout (`room_id`)
+ * is billed through its subscription events, not a desktop licence. Only what
+ * is left is a VC Writer desktop purchase: older checkouts carry no product
+ * stamp and are VC Writer's.
+ */
+export const OWN_PRODUCT = 'vc-writer';
+
+export type CheckoutKind = 'desktop' | 'room' | 'other-product';
+
+export const checkoutKind = (session: { metadata?: Record<string, string> | null }): CheckoutKind => {
+  const product = session.metadata?.['product'];
+  if (product && product !== OWN_PRODUCT) return 'other-product';
+  if (session.metadata?.['room_id']) return 'room';
+  return 'desktop';
+};
